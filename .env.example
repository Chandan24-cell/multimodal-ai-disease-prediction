# Application settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_this_to_a_secure_random_string

# Docker MongoDB service
MONGODB_URI=mongodb://admin:change_this_to_a_real_random_password@mongodb:27017/multimodal_healthcare?authSource=admin
MONGODB_DB_NAME=multimodal_healthcare
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_this_to_a_real_random_password

# Authentication
JWT_SECRET_KEY=change_this_to_another_secure_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# AI / LLM providers
HF_TOKEN=your_huggingface_token_here
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://host.docker.internal:11434

# RAG / vector store
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Docker host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
